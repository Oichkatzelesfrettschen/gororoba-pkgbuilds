_name=proto-plus
pkgname=python-$_name
pkgver=1.29.0
pkgrel=1
pkgdesc="A wrapper around protocol buffers"
arch=(any)
url=https://github.com/googleapis/google-cloud-python
license=(Apache-2.0)
depends=(python python-protobuf)
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz::https://files.pythonhosted.org/packages/46/70/783e33ffbb4466cc154a94f79b869b92a451e2bd45605054e68ff68b7af6/proto_plus-1.29.0.tar.gz")
sha256sums=('cfb4e62ad7e13dd18f346cabbda00cab39930d36a05791fd81ddb074d6ee884f')

build() {
  cd "proto_plus-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "proto_plus-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
