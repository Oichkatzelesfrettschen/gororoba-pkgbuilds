# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=python-ocifs
_pkg=ocifs
pkgver=1.3.4
pkgrel=1
_srcdir=ocifs-$pkgver
pkgdesc="fsspec filesystem for OCI Object Storage"
arch=('any')
url="https://ocifs.readthedocs.io/en/latest/index.html"
license=('custom')
depends=('python' 'python-fsspec' 'python-oci' 'python-requests')
makedepends=('python-build' 'python-installer' 'python-flit-core')
source=("https://files.pythonhosted.org/packages/5b/e0/8d376b294173914b343daded4711cb6e660c8a91761477f096a82ca59b8b/ocifs-1.3.4.tar.gz")
sha256sums=('52658665366210924eca61716ad3fce3c3cdf772c0e95d47fd378db7f969c6f4')

build() {
	cd "$_srcdir"
	python -m build --wheel --no-isolation
}

package() {
	cd "$_srcdir"
	python -m installer --destdir="$pkgdir" dist/*.whl
	find . -maxdepth 1 -iname 'LICENSE*' -exec install -Dm644 {} "$pkgdir/usr/share/licenses/$pkgname/" \;
}
