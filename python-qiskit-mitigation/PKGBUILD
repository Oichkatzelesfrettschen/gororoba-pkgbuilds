# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
# Contributor: Iyán Méndez Veiga <me (at) iyanmv (dot) com>
_pkgname=qiskit-mitigation
pkgname=python-${_pkgname}
pkgver=0.2.0
pkgrel=1
pkgdesc="A toolbox for handling noise in quantum computations"
arch=(any)
url=https://github.com/Qiskit/qiskit-mitigation
license=(Apache-2.0)
depends=(
    python-numpy
    python-qiskit
    python-samplomatic
    python-scipy
)
makedepends=(
    python-build
    python-hatchling
    python-installer
)
checkdepends=(
    python-ddt
    python-pytest
    python-pytest-subtests
)
source=($_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha256sums=('c3e1f460e28a5f2708977401ceb61280ddaed73a8dd99fcd8d27d3d1195aa7ce')

build() {
    cd $_pkgname-$pkgver
    python -m build --wheel --no-isolation
}

check() {
    cd $_pkgname-$pkgver
    python -m venv --system-site-packages test-env
    test-env/bin/python -m installer dist/*.whl
    rm -rf ${_pkgname//-/_}
    test-env/bin/python -P -m pytest -o addopts=""
}

package() {
    cd $_pkgname-$pkgver
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
