# Contributor: Daniel Bershatsky <bepshatsky@yandex.ru>

# Upstream versions through hatch-vcs; a release tarball carries no git
# metadata, so SETUPTOOLS_SCM_PRETEND_VERSION supplies the version. The
# mypyc hook is disabled by default upstream, so the wheel is pure Python.
pkgname=python-plum-dispatch
_name=plum
pkgver=2.10.1
pkgrel=1
pkgdesc='Multiple dispatch in Python'
arch=('any')
url='https://github.com/beartype/plum'
license=('MIT')
conflicts=('python-plum')
depends=('python-beartype' 'python-rich' 'python-typing_extensions')
makedepends=('python-build' 'python-hatch-vcs' 'python-hatchling' 'python-installer')
checkdepends=('ipython' 'python-numpy' 'python-pytest' 'python-sybil')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d66fbb41118e7f1bf04e861487965b19e37a5e0cfe4fde791cdeffbd8f0b12d1')

build() {
	cd "$_name-$pkgver"
	SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver python -m build --wheel --no-isolation
}

check() {
	cd "$_name-$pkgver"
	python -m venv --system-site-packages test-env
	test-env/bin/python -m installer dist/*.whl
	# test_methodlist_repr compares a repr whose source-location line wraps with the length of the
	# build path, which the CI work directory changes.
	# tests/static needs mypy and pyright, which are not packaged.
	test-env/bin/python -P -m pytest -o addopts="" -p no:doctest -p no:cacheprovider tests --ignore=tests/static \
		--deselect tests/test_method.py::test_methodlist_repr
}

package() {
	cd "$_name-$pkgver"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENCE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
