#!/bin/sh
# Fake nvchecker for calibration: NVFAKE selects ok, fail or empty.
case "${NVFAKE:-ok}" in
    ok)
        printf '%s\n' '{"event": "updated", "name": "one", "version": "1.1"}'
        printf '%s\n' '{"version": "2.0", "name": "two", "event": "up-to-date"}'
        printf '%s\n' '{"event": "updated", "name": "three", "version": "5.0-beta"}'
        printf '%s\n' '{"event": "updated", "name": "five", "version": "3.0"}'
        printf '%s\n' '{"level": "error", "event": "no-result", "name": "four"}'
        ;;
    fail) exit 3 ;;
    empty) ;;
esac
