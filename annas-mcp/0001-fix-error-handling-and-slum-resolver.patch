new file mode 100644
index 0000000..9e535dd
--- /dev/null
+++ b/internal/modes/mcpserver_test.go
@@ -0,0 +1,99 @@
+package modes
+
+import (
+	"context"
+	"math"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestTimeoutFromSeconds(t *testing.T) {
+	// 0 defaults to defaultMCPTimeout
+	d, err := timeoutFromSeconds(0)
+	if err != nil || d != defaultMCPTimeout {
+		t.Fatalf("expected default timeout %v, got %v (err: %v)", defaultMCPTimeout, d, err)
+	}
+
+	// Negative value rejected
+	_, err = timeoutFromSeconds(-5)
+	if err == nil {
+		t.Fatal("expected error for negative seconds, got nil")
+	}
+
+	// Normal positive value
+	d, err = timeoutFromSeconds(45)
+	if err != nil || d != 45*time.Second {
+		t.Fatalf("expected 45s, got %v (err: %v)", d, err)
+	}
+
+	// Overflow guard: math.MaxInt should fail cleanly without integer overflow wrap
+	_, err = timeoutFromSeconds(math.MaxInt)
+	if err == nil {
+		t.Fatal("expected overflow error for math.MaxInt seconds, got nil")
+	}
+	if !strings.Contains(err.Error(), "exceeds maximum allowable duration") {
+		t.Fatalf("expected overflow error message, got: %v", err)
+	}
+}
+
+func TestBookDownloadToolReturnsIsErrorOnInvalidInput(t *testing.T) {
+	ctx := context.Background()
+
+	// Invalid MD5 hash
+	params := &mcp.CallToolParamsFor[BookDownloadParams]{
+		Arguments: BookDownloadParams{
+			BookHash: "not-an-md5",
+			Title:    "Some Title",
+			Format:   "pdf",
+		},
+	}
+
+	res, err := BookDownloadTool(ctx, nil, params)
+	if err != nil {
+		t.Fatalf("expected protocol error nil for tool failure, got: %v", err)
+	}
+	if res == nil {
+		t.Fatal("expected CallToolResultFor, got nil")
+	}
+	if !res.IsError {
+		t.Fatal("expected res.IsError == true for invalid MD5 hash")
+	}
+
+	// Hostile path traversal format
+	paramsFormat := &mcp.CallToolParamsFor[BookDownloadParams]{
+		Arguments: BookDownloadParams{
+			BookHash: "0123456789abcdef0123456789abcdef",
+			Title:    "Some Title",
+			Format:   "../../../evil",
+		},
+	}
+
+	resFormat, err := BookDownloadTool(ctx, nil, paramsFormat)
+	if err != nil {
+		t.Fatalf("expected protocol error nil, got: %v", err)
+	}
+	if !resFormat.IsError {
+		t.Fatal("expected res.IsError == true for path traversal format")
+	}
+}
+
+func TestArticleDownloadToolReturnsIsErrorOnInvalidDOI(t *testing.T) {
+	ctx := context.Background()
+
+	params := &mcp.CallToolParamsFor[ArticleDownloadParams]{
+		Arguments: ArticleDownloadParams{
+			DOI: "invalid-doi-without-10-prefix",
+		},
+	}
+
+	res, err := ArticleDownloadTool(ctx, nil, params)
+	if err != nil {
+		t.Fatalf("expected protocol error nil for tool failure, got: %v", err)
+	}
+	if res == nil || !res.IsError {
+		t.Fatal("expected CallToolResult with IsError == true")
+	}
+}
