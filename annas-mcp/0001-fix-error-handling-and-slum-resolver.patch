+	"fmt"
+	"regexp"
+	"strings"
+)
+
+var (
+	ErrNotFound       = errors.New("no record found")
+	ErrInvalidFormat  = errors.New("invalid file format")
+	ErrInvalidHash    = errors.New("invalid content hash")
+	ErrInvalidDOI     = errors.New("invalid DOI")
+	ErrUnexpectedPage = errors.New("unexpected response page layout")
+)
+
+var AllowedBookFormats = map[string]struct{}{
+	"pdf":  {},
+	"epub": {},
+	"mobi": {},
+	"azw3": {},
+	"djvu": {},
+	"cbz":  {},
+	"cbr":  {},
+	"fb2":  {},
+	"doc":  {},
+	"docx": {},
+	"txt":  {},
+}
+
+var md5Regex = regexp.MustCompile(`^[a-fA-F0-9]{32}$`)
+
+func ValidateMD5(hash string) error {
+	clean := strings.TrimSpace(hash)
+	if !md5Regex.MatchString(clean) {
+		return fmt.Errorf("%w: %q (must be exactly 32 hexadecimal characters)", ErrInvalidHash, hash)
+	}
+	return nil
+}
+
+func ValidateFormat(format string) (string, error) {
+	clean := strings.ToLower(strings.TrimSpace(format))
+	clean = strings.TrimPrefix(clean, ".")
+	if clean == "" {
+		return "", fmt.Errorf("%w: format cannot be empty", ErrInvalidFormat)
+	}
+	if _, ok := AllowedBookFormats[clean]; !ok {
+		return "", fmt.Errorf("%w: %q (allowed: pdf, epub, mobi, azw3, djvu, cbz, cbr, fb2, doc, docx, txt)", ErrInvalidFormat, format)
+	}
+	return clean, nil
+}
+
+func NormalizeDOI(doi string) (string, error) {
+	clean := strings.TrimSpace(doi)
+	prefixes := []string{
+		"https://doi.org/",
+		"http://doi.org/",
+		"https://dx.doi.org/",
+		"http://dx.doi.org/",
+		"dx.doi.org/",
+		"doi.org/",
+		"doi:",
+		"DOI:",
+	}
+	for _, p := range prefixes {
+		if len(clean) >= len(p) && strings.EqualFold(clean[:len(p)], p) {
+			clean = strings.TrimSpace(clean[len(p):])
+			break
+		}
+	}
+	clean = strings.TrimPrefix(clean, "/")
+	if !strings.HasPrefix(clean, "10.") {
+		return "", fmt.Errorf("%w: %q (must start with '10.')", ErrInvalidDOI, doi)
+	}
+	return clean, nil
+}
 
