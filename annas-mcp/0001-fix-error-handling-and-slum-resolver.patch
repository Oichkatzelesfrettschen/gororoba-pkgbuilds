+func TestConcurrentDownloadsSameName(t *testing.T) {
+	var ts *httptest.Server
+	payloadA := []byte("payload from download A")
+	payloadB := []byte("payload from download B")
+
+	ts = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/dyn/api/fast_download.json":
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(fastDownloadResponse{
+				DownloadURL: ts.URL + "/file",
+			})
+		case "/file":
+			w.Header().Set("Content-Type", "application/pdf")
+			if r.Header.Get("X-Client") == "A" {
+				w.Write(payloadA)
+			} else {
+				w.Write(payloadB)
+			}
+		}
+	}))
+	defer ts.Close()
+
+	u, _ := url.Parse(ts.URL)
+	t.Setenv("ANNAS_DOWNLOAD_BASE_URL", u.Host)
+
+	targetDir := t.TempDir()
+	book := &Book{
+		Hash:   "0123456789abcdef0123456789abcdef",
+		Title:  "Concurrent Title",
+		Format: "pdf",
+	}
+
+	var wg sync.WaitGroup
+	errs := make([]error, 2)
+
+	for i := 0; i < 2; i++ {
+		wg.Add(1)
+		idx := i
+		go func() {
+			defer wg.Done()
+			errs[idx] = book.Download(context.Background(), "test-key", targetDir, 5*time.Second)
+		}()
+	}
+
+	wg.Wait()
+
+	for i, err := range errs {
+		if err != nil {
+			t.Fatalf("goroutine %d failed: %v", i, err)
+		}
+	}
+
+	finalPath := filepath.Join(targetDir, "Concurrent Title.pdf")
+	content, err := os.ReadFile(finalPath)
+	if err != nil {
+		t.Fatalf("final file not found: %v", err)
+	}
+
+	// Must match either payload A or payload B in its entirety, never corrupted or partial
+	if string(content) != string(payloadA) && string(content) != string(payloadB) {
+		t.Fatalf("corrupted file content from concurrent download: %q", string(content))
+	}
+
+	entries, _ := os.ReadDir(targetDir)
+	if len(entries) != 1 {
+		t.Fatalf("expected exactly 1 final file, got %d", len(entries))
+	}
+}
