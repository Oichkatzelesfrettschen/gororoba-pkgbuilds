+func TestBookDownloadWithMockServer_Success(t *testing.T) {
+	dummyPayload := []byte("%PDF-1.4 dummy ebook content for test")
+
+	var ts *httptest.Server
+	ts = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/dyn/api/fast_download.json":
+			q := r.URL.Query()
+			if q.Get("key") != "test-secret-key" {
+				w.WriteHeader(http.StatusForbidden)
+				json.NewEncoder(w).Encode(fastDownloadResponse{Error: "invalid key"})
+				return
+			}
+			if q.Get("md5") != "0123456789abcdef0123456789abcdef" {
+				w.WriteHeader(http.StatusNotFound)
+				json.NewEncoder(w).Encode(fastDownloadResponse{Error: "not found"})
+				return
+			}
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(fastDownloadResponse{
+				DownloadURL: ts.URL + "/download/file.pdf",
+			})
+		case "/download/file.pdf":
+			w.Header().Set("Content-Type", "application/pdf")
+			w.WriteHeader(http.StatusOK)
+			w.Write(dummyPayload)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer ts.Close()
+
+	u, err := url.Parse(ts.URL)
+	if err != nil {
+		t.Fatalf("failed to parse test server url: %v", err)
+	}
+
+	t.Setenv("ANNAS_DOWNLOAD_BASE_URL", u.Host)
+
+	targetDir := t.TempDir()
+	book := &Book{
+		Hash:   "0123456789abcdef0123456789abcdef",
+		Title:  "Test Book Title",
+		Format: "pdf",
+	}
+
+	ctx := context.Background()
+	err = book.Download(ctx, "test-secret-key", targetDir, 5*time.Second)
+	if err != nil {
+		t.Fatalf("book.Download failed: %v", err)
+	}
+
+	expectedPath := filepath.Join(targetDir, "Test Book Title.pdf")
+	content, err := os.ReadFile(expectedPath)
+	if err != nil {
+		t.Fatalf("downloaded file not found at %s: %v", expectedPath, err)
+	}
+
+	if string(content) != string(dummyPayload) {
+		t.Fatalf("content mismatch: got %q, expected %q", string(content), string(dummyPayload))
+	}
+
+	fi, err := os.Stat(expectedPath)
+	if err != nil {
+		t.Fatalf("stat failed: %v", err)
+	}
+	if fi.Mode().Perm() != 0600 {
+		t.Errorf("expected file mode 0600, got %o", fi.Mode().Perm())
+	}
+
+	// Verify no temporary files remain
+	entries, err := os.ReadDir(targetDir)
+	if err != nil {
+		t.Fatalf("ReadDir failed: %v", err)
+	}
+	if len(entries) != 1 {
+		t.Fatalf("expected exactly 1 file in download dir, found %d", len(entries))
+	}
+}
