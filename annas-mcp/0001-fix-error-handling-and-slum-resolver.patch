+func TestNormalizeDOI(t *testing.T) {
+	cases := []struct {
+		input    string
+		expected string
+	}{
+		{"10.1038/nature12345", "10.1038/nature12345"},
+		{"doi:10.1038/nature12345", "10.1038/nature12345"},
+		{"DOI:10.1038/nature12345", "10.1038/nature12345"},
+		{"https://doi.org/10.1038/nature12345", "10.1038/nature12345"},
+		{"http://doi.org/10.1038/nature12345", "10.1038/nature12345"},
+		{"https://dx.doi.org/10.1038/nature12345", "10.1038/nature12345"},
+		{"http://dx.doi.org/10.1038/nature12345", "10.1038/nature12345"},
+		{"dx.doi.org/10.1038/nature12345", "10.1038/nature12345"},
+		{"doi.org/10.1038/nature12345", "10.1038/nature12345"},
+		{"  https://doi.org/10.1038/nature12345  ", "10.1038/nature12345"},
+	}
+
+	for _, tc := range cases {
+		got, err := NormalizeDOI(tc.input)
+		if err != nil {
+			t.Errorf("NormalizeDOI(%q) failed: %v", tc.input, err)
+		}
+		if got != tc.expected {
+			t.Errorf("NormalizeDOI(%q) = %q, expected %q", tc.input, got, tc.expected)
+		}
+	}
+
+	invalid := []string{
+		"not-a-doi",
+		"11.1038/invalid",
+		"https://example.com/paper",
+		"",
+		"doi:",
+	}
+	for _, in := range invalid {
+		_, err := NormalizeDOI(in)
+		if err == nil {
+			t.Errorf("NormalizeDOI(%q) unexpectedly succeeded", in)
+		}
+		if !errors.Is(err, ErrInvalidDOI) {
+			t.Errorf("NormalizeDOI(%q) error %v should wrap ErrInvalidDOI", in, err)
+		}
+	}
