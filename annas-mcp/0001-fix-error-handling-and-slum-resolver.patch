+func TestValidateFormat(t *testing.T) {
+	validFormats := []string{"pdf", "EPUB", "Mobi", ".azw3", "djvu", "cbz", "CBR", "fb2", "doc", "docx", "txt"}
+	for _, fmtStr := range validFormats {
+		clean, err := ValidateFormat(fmtStr)
+		if err != nil {
+			t.Errorf("ValidateFormat(%q) unexpectedly failed: %v", fmtStr, err)
+		}
+		if clean == "" {
+			t.Errorf("ValidateFormat(%q) returned empty string", fmtStr)
+		}
+	}
+
+	invalidFormats := []string{
+		"../../../evil",
+		"exe",
+		"sh",
+		"",
+		"   ",
+		"bin",
+		"/etc/passwd",
+		"pdf/../../sh",
+		"docx;rm -rf /",
+	}
+	for _, fmtStr := range invalidFormats {
+		_, err := ValidateFormat(fmtStr)
+		if err == nil {
+			t.Errorf("ValidateFormat(%q) unexpectedly succeeded", fmtStr)
+		}
+		if !errors.Is(err, ErrInvalidFormat) {
+			t.Errorf("ValidateFormat(%q) error %v should wrap ErrInvalidFormat", fmtStr, err)
+		}
+	}
+}
+
+func TestValidateMD5(t *testing.T) {
+	valid := "0123456789abcdef0123456789ABCDEF"
+	if err := ValidateMD5(valid); err != nil {
+		t.Errorf("ValidateMD5(%q) unexpectedly failed: %v", valid, err)
+	}
+
+	invalid := []string{
+		"123",
+		"0123456789abcdef0123456789abcdef0123456789abcdef",
+		"not-a-hash-at-all-0123456789abc",
+		"0123456789abcdef0123456789abcdeZ",
+		"../0123456789abcdef0123456789ab",
+		"",
+	}
+	for _, h := range invalid {
+		err := ValidateMD5(h)
+		if err == nil {
+			t.Errorf("ValidateMD5(%q) unexpectedly succeeded", h)
+		}
+		if !errors.Is(err, ErrInvalidHash) {
+			t.Errorf("ValidateMD5(%q) error %v should wrap ErrInvalidHash", h, err)
+		}
+	}
+}
