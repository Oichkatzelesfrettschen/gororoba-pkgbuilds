# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=python-qwasm
_pkg=qwasm
pkgver=1.0.1
pkgrel=1
pkgdesc="Quantum circuit compiler backend for WebAssembly-based simulators"
arch=('any')
url="https://github.com/CQCL/qwasm"
license=('MIT')
depends=('python' 'python-setuptools')
makedepends=('python-build' 'python-installer' 'python-wheel')
source=("qwasm-1.0.1.tar.gz::https://files.pythonhosted.org/packages/6f/a1/b52f356f907bedf02f536970c1b46aa69bc57280c4d17ed6b5c39180959f/qwasm-1.0.1.tar.gz")
sha256sums=('01f5dfe27159b7fdd9d02cd299833225d528fa383d1278268e5e1526357950fb')

build() {
	cd "qwasm-1.0.1"
	python -m build --wheel --no-isolation
}

# The sdist ships no test suite that runs offline; check() is absent.
package() {
	cd "qwasm-1.0.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
