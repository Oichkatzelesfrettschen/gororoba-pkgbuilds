#!/bin/sh
post_install() {
  _semgrep_source_install_venv
}

post_upgrade() {
  _semgrep_source_install_venv
}

pre_remove() {
  rm -rf /usr/share/semgrep-source/venv
}

_semgrep_source_install_venv() {
  root=/usr/share/semgrep-source
  rm -rf "${root}/venv"
  python -m venv "${root}/venv"
  "${root}/venv/bin/python" -m pip install \
    --no-cache-dir \
    --no-index \
    --find-links "${root}/wheelhouse" \
    --force-reinstall \
    "${root}"/wheelhouse/semgrep-*.whl
}
