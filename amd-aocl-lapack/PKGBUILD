# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=amd-aocl-lapack
pkgver=5.3
pkgrel=1
pkgdesc='Thin LAPACK and LAPACKE provider links for AMD AOCL libFLAME'
arch=('x86_64')
url='https://github.com/amd/libflame'
license=('BSD-3-Clause')
depends=("amd-aocl-libflame=${pkgver}")
provides=('lapack=3.12.1' 'lapacke=3.12.1')
conflicts=('lapack' 'lapacke')
options=('!emptydirs')

package() {
    install -d \
        "${pkgdir}/usr/lib" \
        "${pkgdir}/usr/lib/pkgconfig" \
        "${pkgdir}/usr/share/licenses/${pkgname}"

    # Generic LAPACK ownership is separated from amd-aocl-libflame so users can
    # install libFLAME without replacing the system provider.
    ln -s libflame.so "${pkgdir}/usr/lib/liblapack.so"
    ln -s libflame.so "${pkgdir}/usr/lib/liblapack.so.3"
    ln -s libflame.so "${pkgdir}/usr/lib/liblapacke.so"
    ln -s libflame.so "${pkgdir}/usr/lib/liblapacke.so.3"
    ln -s flame.pc "${pkgdir}/usr/lib/pkgconfig/lapack.pc"
    ln -s flame.pc "${pkgdir}/usr/lib/pkgconfig/lapacke.pc"

    printf '%s\n' \
        "This package installs provider links for amd-aocl-libflame." \
        "The implementation license is installed by amd-aocl-libflame." \
        > "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
