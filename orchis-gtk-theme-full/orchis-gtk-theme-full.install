# shellcheck shell=sh
# Post-install script for orchis-gtk-theme-full

post_install() {
    echo ""
    echo "====================================================================="
    echo "  Orchis GTK Theme Full - Installation Complete!"
    echo "====================================================================="
    echo ""
    echo "Installed 162 theme variants covering:"
    echo "  - GTK2, GTK3, GTK4/libadwaita"
    echo "  - GNOME Shell (versions 38-49)"
    echo "  - Xfwm4 window manager"
    echo "  - 9 color variants × 3 schemes × 2 sizes × 3 DPI scales"
    echo ""
    echo "Location: /usr/share/themes/Orchis-*"
    echo ""
    echo "---------------------------------------------------------------------"
    echo "  Quick Setup Commands"
    echo "---------------------------------------------------------------------"
    echo ""
    echo "For OLED displays (pure black, power-saving):"
    echo "  gsettings set org.gnome.desktop.interface gtk-theme \"Orchis-Dark\""
    echo ""
    echo "For CachyOS Nord branding (cyan accent):"
    echo "  gsettings set org.gnome.desktop.interface gtk-theme \"Orchis-Teal-Dark\""
    echo ""
    echo "Enable dark mode system-wide:"
    echo "  gsettings set org.gnome.desktop.interface color-scheme \"prefer-dark\""
    echo ""
    echo "---------------------------------------------------------------------"
    echo "  GNOME Shell Theme (Optional)"
    echo "---------------------------------------------------------------------"
    echo ""
    echo "To apply GNOME Shell theme:"
    echo "  1. Install extension: sudo pacman -S gnome-shell-extension-user-theme"
    echo "  2. Enable extension: gnome-extensions enable user-theme@gnome-shell-extensions.gcampax.github.com"
    echo "  3. Apply theme: gsettings set org.gnome.shell.extensions.user-theme name \"Orchis-Dark\""
    echo ""
    echo "---------------------------------------------------------------------"
    echo "  Recommended Icon Themes"
    echo "---------------------------------------------------------------------"
    echo ""
    echo "Install recommended icon themes for complete desktop theming:"
    echo "  sudo pacman -S papirus-icon-theme    # Comprehensive, highly recommended"
    echo "  yay -S nordzy-icon                    # Nord palette (matches CachyOS)"
    echo "  yay -S tela-circle-icon-theme         # Circular icons (same author)"
    echo "  yay -S qogir-icon-theme               # Minimalist professional"
    echo ""
    echo "Apply icon theme:"
    echo "  gsettings set org.gnome.desktop.interface icon-theme \"Papirus-Dark\""
    echo ""
    echo "---------------------------------------------------------------------"
    echo "  Flatpak Application Theming"
    echo "---------------------------------------------------------------------"
    echo ""
    echo "To theme Flatpak applications:"
    echo "  flatpak override --user --filesystem=xdg-data/themes"
    echo "  flatpak override --user --filesystem=xdg-data/icons"
    echo "  flatpak override --user --env=GTK_THEME=Orchis-Dark"
    echo ""
    echo "---------------------------------------------------------------------"
    echo "  Documentation"
    echo "---------------------------------------------------------------------"
    echo ""
    echo "Read comprehensive guides:"
    echo "  - /usr/share/doc/orchis-gtk-theme-full/README.md"
    echo "  - /usr/share/doc/orchis-gtk-theme-full/CACHYOS-RICING-GUIDE.md"
    echo ""
    echo "View all installed themes:"
    echo "  ls /usr/share/themes/ | grep Orchis"
    echo ""
    echo "Verify installation (should show 162):"
    echo "  ls -d /usr/share/themes/Orchis* | wc -l"
    echo ""
    echo "====================================================================="
    echo "  Enjoy your unified GTK2/3/4 + GNOME Shell theme experience!"
    echo "====================================================================="
    echo ""
}

post_upgrade() {
    post_install "$1"
}

post_remove() {
    echo ""
    echo "====================================================================="
    echo "  Orchis GTK Theme Full - Removed"
    echo "====================================================================="
    echo ""
    echo "All theme files have been removed from /usr/share/themes/"
    echo ""
    echo "Your theme preferences in gsettings remain unchanged."
    echo "You may want to switch to a different theme:"
    echo ""
    echo "  gsettings set org.gnome.desktop.interface gtk-theme \"Adwaita\""
    echo "  gsettings set org.gnome.shell.extensions.user-theme name \"\""
    echo ""
    echo "====================================================================="
    echo ""
}
