# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=python-mitiq
_name=mitiq
pkgver=1.1.0
pkgrel=1
pkgdesc="Error mitigation for quantum programs"
arch=(any)
url=https://github.com/unitaryfoundation/mitiq
license=(GPL-3.0-or-later)
depends=(
    python
    'python-cirq-core>=1.6.0'
    'python-cirq-core<1.7.0'
    python-matplotlib
    'python-numpy>=2.0.0'
    'python-numpy<2.3.0'
    'python-scipy>=1.10.1'
    'python-scipy<=1.17.1'
    python-tabulate
)
makedepends=(
    python-build
    python-installer
    python-setuptools
    python-wheel
)
# The cirq-core upper bound, numpy<2.3 and scipy<=1.17.1 are upstream pins kept as
# written; current Arch packages (cirq 1.7.0, numpy 2.5.5, scipy 1.18.1) violate them.
# No check() is declared: the upstream tests import optional backends that this
# recipe does not depend on.
source=("https://files.pythonhosted.org/packages/6f/f0/ddcec894c42fa50eca60ba1880dfc0f24c0e8d7bda2435f6ead29591e344/mitiq-1.1.0.tar.gz")
sha256sums=('4db99d4667bd7f606e59f3715ecfccc37992ed146d1c8d373023405ff9ee38f0')

build() {
    cd "$_name-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$_name-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
