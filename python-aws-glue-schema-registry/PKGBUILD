# On Python 3.11 and newer the metadata asks for orjson>=3.7.7. Installed orjson is 3.13.0.
# The ~=3.6.0 marker applies only to Python older than 3.11.
# fastjsonschema~=2.15 means >=2.15,<3. Installed python-fastjsonschema 2.21.2 satisfies it.
# python-fastavro comes from the AUR at 1.13.1, which matches PyPI.
# The wheel's source URL is the DisasterAWARE fork. aws-samples returns 404.

pkgname=python-aws-glue-schema-registry
pkgver=1.1.3
pkgrel=1
pkgdesc='Serde client for the AWS Glue Schema Registry'
arch=('any')
url='https://github.com/DisasterAWARE/aws-glue-schema-registry-python'
license=('Apache-2.0')
depends=('python' 'python-boto3' 'python-fastavro' 'python-fastjsonschema>=2.15' 'python-fastjsonschema<3' 'python-orjson>=3.7.7')
makedepends=('python-installer')
_wheel='aws_glue_schema_registry-1.1.3-py3-none-any.whl'
source=("$_wheel::https://files.pythonhosted.org/packages/cc/32/025a53122c8648d9acb896d3516c30714f3260a78ead44f90e199e18cfd2/aws_glue_schema_registry-1.1.3-py3-none-any.whl")
noextract=("$_wheel")
sha256sums=('590b95edd8b135c9ac74f985c05d117ea79ef6e56209ab90bc0b2fcc222e8fff')

package() {
	python -m installer --destdir="$pkgdir" "$_wheel"
}
