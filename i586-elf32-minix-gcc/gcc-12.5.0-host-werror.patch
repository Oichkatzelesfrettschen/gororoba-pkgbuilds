 static bool
+read_all_bytes (int fd, off_t offset, char *buffer, size_t size)
+{
+  if (lseek (fd, offset, SEEK_SET) < 0)
+    return false;
+
+  while (size > 0)
+    {
+      ssize_t bytes_read = read (fd, buffer, size);
+      if (bytes_read > 0)
+	{
+	  buffer += bytes_read;
+	  size -= bytes_read;
+	}
+      else if (bytes_read == 0)
+	return false;
+      else if (errno != EINTR)
+	return false;
+    }
+
+  return true;
+}
