# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
# The Mesa CI VK-GL-CTS/dEQP wrapper.  Neither the official repos nor the
# AUR carry it, so this builds the published crate directly.  epoch=1
# reserves precedence should a distro package appear later at a lower
# version.

pkgname=deqp-runner
epoch=1
pkgver=0.24.0
pkgrel=1
pkgdesc="Parallel VK-GL-CTS/dEQP test runner reporting results against a baseline"
arch=('x86_64' 'aarch64')
url="https://gitlab.freedesktop.org/mesa/deqp-runner"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate")
sha256sums=('06bc5432359b2150cde819f2e324995c1ce3b29ce060af9d5cb9526d1481f5e2')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" || cargo fetch
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen 2>/dev/null || cargo build --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
}
