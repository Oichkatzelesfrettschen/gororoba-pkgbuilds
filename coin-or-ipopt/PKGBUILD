# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

# Ipopt with the MUMPS linear solver from coin-or-coinmumps. HSL stays off
# (proprietary; load it at run time through libhsl).

pkgname=coin-or-ipopt
pkgver=3.14.20
pkgrel=1
pkgdesc='Interior Point OPTimizer'
arch=('x86_64')
url='https://github.com/coin-or/Ipopt'
license=('EPL-2.0')
groups=('coin-or')
depends=('lapack' 'coin-or-asl' 'coin-or-coinmumps' 'gcc-libs')
makedepends=('gcc-fortran' 'pkgconf')
provides=("ipopt=$pkgver")
source=("$pkgname-$pkgver.tar.gz::https://github.com/coin-or/Ipopt/archive/releases/$pkgver.tar.gz")
sha256sums=('43bddd6fa793b1694aa94d6129fe3e4a8d452d97a84ef5f2ff721c8047c75605')

build() {
  mkdir -p build
  cd build
  "$srcdir/Ipopt-releases-$pkgver/configure" --prefix=/usr --without-hsl --disable-java
  make
}

check() {
  cd build
  make test
}

package() {
  cd build
  PKG_CONFIG_LIBDIR="$pkgdir/usr/lib/pkgconfig/" \
    make DESTDIR="$pkgdir" install
  # for compatibility
  install -d "$pkgdir/usr/include/coin"
  install -m644 "$pkgdir"/usr/include/coin-or/* "$pkgdir/usr/include/coin"
  install -Dm644 "$srcdir/Ipopt-releases-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
