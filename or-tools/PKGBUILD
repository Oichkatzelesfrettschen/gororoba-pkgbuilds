# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
# Contributor: Aleksandar Trifunović <akstrfn at gmail dot com>

# One build, two packages: the C++ library and the Python binding. The Python
# wheel comes from the same CMake tree (BUILD_PYTHON), so it matches the C++
# library version; PyPI ships wheels only. pybind11_abseil, pybind11_protobuf
# and mypy-protobuf are not Arch packages: pybind11_abseil and pybind11_protobuf
# are fetched by CMake at build time (network at build, none at install).
# pybind11_protobuf is the exception: the commit pinned by or-tools 9.15
# (2025-02-10) overrides DescriptorDatabase::FindFileByName and its two
# siblings with const std::string& parameters, and protobuf 34 and later
# declare them with absl::string_view, so the build stops with "marked
# 'override', but does not override". The archive of upstream commit 5b61b4c
# (2026-10-01, after the "Fix DescriptorDatabase override signatures for
# Protobuf 34+" change) replaces the fetch through
# FETCHCONTENT_SOURCE_DIR_PYBIND11_PROTOBUF.
# mypy-protobuf is the protoc plugin that writes the .pyi stubs. CMake would
# pip-install it into the user site, which the container's PEP 668 marker
# refuses, so the checksummed wheel is unpacked under $srcdir and exposed
# through PYTHONPATH and PATH for the build only.

pkgbase=or-tools
pkgname=('or-tools' 'python-ortools')
_tag=9.15
_pbp=5b61b4cbc654e8c89a854b0abc814d676986f09c
# The patch level is the upstream commit count that the PyPI release uses.
pkgver=9.15.6755
pkgrel=2
pkgdesc="Google's Operations Research tools"
arch=('x86_64')
url='https://github.com/google/or-tools'
license=('Apache-2.0')
makedepends=('cmake' 'pkgconf' 'git' 'eigen' 'gtest' 'coin-or-cbc' 'protobuf' 're2' 'abseil-cpp'
             'swig' 'pybind11' 'python' 'python-pip' 'python-setuptools' 'python-wheel'
             'python-installer' 'python-numpy' 'python-pandas' 'python-protobuf' 'python-absl'
             'python-immutabledict' 'python-typing_extensions' 'mypy')
source=("$pkgbase-$_tag.tar.gz::$url/archive/v$_tag.tar.gz"
        'source-location-absl.patch'
        'cp-model-helper-pybind11-3-keep-alive.patch'
        'sat-wrappers-pybind11-3-keep-alive.patch'
        'elemental-pybind11-3-enum-caster.patch'
        "pybind11_protobuf-$_pbp.tar.gz::https://github.com/pybind/pybind11_protobuf/archive/$_pbp.tar.gz"
        'mypy_protobuf-5.1.0-py3-none-any.whl::https://files.pythonhosted.org/packages/e8/ec/5ffcf8f5f53757e01afdece10c664e694ac60d2f17c2036811b85b842a5b/mypy_protobuf-5.1.0-py3-none-any.whl')
noextract=('mypy_protobuf-5.1.0-py3-none-any.whl')
sha256sums=('6395a00a97ff30af878ee8d7fd5ad0ab1c7844f7219182c6d71acbee1b5f3026'
            '4cef55e2990f1350fbd3c1277ef6a5c2295ae5910cfe99f521aa82343fe0a0fe'
            '25f762c3002f35ce453a2fea02a789e567df101ee21f37ce9e24a1408ab7a01e'
            '5d101a223517c34acbd7da7b13beb70bc78f36fe5a98d40441946974a689d79c'
            '40fce53e35cd6bd8ecaf958c208e3271963c3538ba24a896bf65b1eb230bdc1a'
            '43ea0718703b4f75b5bf831d8c40e97564c3ab7b64a05ebafb5324688bb40ff4'
            'd7031f563f806b8bcd448a3e86768bf0994c0af5b0017b344a4fbbba4191f43c')

prepare() {
  # Fix `absl::SourceLocation` ambiguity with abseil-cpp >= 20260526.
  # https://github.com/google/or-tools/issues/5236
  # https://github.com/google/or-tools/pull/5256 (unmerged, vendored)
  patch -p1 -d "$pkgbase-$_tag" -i "$srcdir/source-location-absl.patch"
  # Upstream bdcf172c8 (after 9.15): pybind11 3 rejects py::keep_alive in the
  # def_property family of ortools/sat/python/cp_model_helper.cc.
  patch -Np1 -d "$pkgbase-$_tag" -i "$srcdir/cp-model-helper-pybind11-3-keep-alive.patch"
  # Upstream 741965107 (after 9.15), retargeted to ortools/sat/python: the
  # generated SatParameters wrappers pass keep_alive to def_property_readonly.
  patch -Np1 -d "$pkgbase-$_tag" -i "$srcdir/sat-wrappers-pybind11-3-keep-alive.patch"
  # Upstream 48e8023bb (after 9.15): pybind11 3's default enum caster collides
  # with the elemental AttrType casters.
  patch -Np1 -d "$pkgbase-$_tag" -i "$srcdir/elemental-pybind11-3-enum-caster.patch"
  python -m installer --destdir="$srcdir/mypy-protobuf" \
    "$srcdir/mypy_protobuf-5.1.0-py3-none-any.whl"

  # Python 3 has one integer type, PyLong_Type, and no PyInt_* C-API. The
  # headers and SWIG typemaps of or-tools 9.15 still call PyInt_AsLong,
  # PyInt_Check and PyInt_FromLong, which SWIG's Python 3 compatibility
  # macros used to alias to the PyLong_* functions; the SWIG 4.5 toolchain
  # no longer defines them ("'PyInt_AsLong' was not declared in this scope").
  # The PyString_* names that remain are shimmed to PyUnicode_* and
  # PyBytes_* inside python-swig.h itself and need no edit. python-swig.h
  # keeps its own PyInt_FromLong alias (an #undef and #define pair).
  local _src="$pkgbase-$_tag/ortools"
  sed -i 's/\bPyInt_AsLong\b/PyLong_AsLong/g' \
    "$_src/base/python-swig.h" \
    "$_src/constraint_solver/python/routing_types.swig"
  sed -i -e 's/\bPyInt_Check\b/PyLong_Check/g' \
    -e 's/\bPyInt_FromLong\b/PyLong_FromLong/g' \
    "$_src/constraint_solver/python/routing_types.swig" \
    "$_src/util/python/vector.swig"
  # Verify the edits: the new names are present and no old name is left
  # outside the python-swig.h alias.
  grep -q 'PyLong_AsLong(py)' "$_src/base/python-swig.h"
  grep -q 'PyLong_AsLong($input)' "$_src/constraint_solver/python/routing_types.swig"
  grep -q 'PyLong_Check, PyInt_FromIndexT' "$_src/constraint_solver/python/routing_types.swig"
  grep -q 'PyLong_Check, PyLong_FromLong' "$_src/util/python/vector.swig"
  if grep -rnE '\bPyInt_(AsLong|Check|FromLong)\b' "$_src" --exclude=python-swig.h; then
    echo "Python 2 integer C-API names remain" >&2
    return 1
  fi
  if grep -nE '\bPyInt_(AsLong|Check)\b' "$_src/base/python-swig.h"; then
    echo "Python 2 integer C-API names remain in python-swig.h" >&2
    return 1
  fi
}

build() {
  local _site
  _site="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  export PYTHONPATH="$srcdir/mypy-protobuf$_site"
  export PATH="$srcdir/mypy-protobuf/usr/bin:$PATH"
  export OR_TOOLS_PATCH="${pkgver##*.}"
  cmake -S "$pkgbase-$_tag" -B build \
    -DCMAKE_C_FLAGS:STRING="${CFLAGS}" \
    -DCMAKE_CXX_FLAGS:STRING="${CXXFLAGS}" \
    -DCMAKE_EXE_LINKER_FLAGS:STRING="${LDFLAGS}" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_DEPS=OFF \
    -DUSE_HIGHS=OFF \
    -DUSE_SCIP=OFF \
    -DUSE_SYSTEM_ABSEIL=ON \
    -DUSE_SYSTEM_PROTOBUF=ON \
    -DBUILD_SAMPLES=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF \
    -DBUILD_PYTHON=ON \
    -DBUILD_VENV=OFF \
    -DBUILD_pybind11_abseil=ON \
    -DBUILD_pybind11_protobuf=ON \
    -DFETCHCONTENT_SOURCE_DIR_PYBIND11_PROTOBUF="$srcdir/pybind11_protobuf-$_pbp" \
    -DFETCH_PYTHON_DEPS=ON \
    -Wno-dev
  cmake --build build
}

# check() is absent: upstream tests build with BUILD_TESTING=ON, which also
# switches on the venv step that installs from PyPI and doubles the build time.

package_or-tools() {
  depends=('coin-or-cbc' 'protobuf' 're2' 'abseil-cpp')
  DESTDIR="$pkgdir" cmake --install build
  # The Python binding ships in python-ortools. python-install.cmake hands
  # setup.py literal quotes (--root='...' --prefix="/usr"), so the Python tree
  # may be absent from $pkgdir or installed to a misplaced directory; remove
  # it only when it is present.
  find "$pkgdir/usr/lib" -maxdepth 1 -name 'python*' -exec rm -r {} +
  install -d -m 755 "$pkgdir/usr/share/examples"
  cp -a "$pkgbase-$_tag/examples/cpp" "$pkgdir/usr/share/examples/cpp"
  install -Dm644 "$pkgbase-$_tag/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_python-ortools() {
  pkgdesc='Python binding of Google OR-Tools (built from source, matches the C++ package)'
  depends=('python' 'python-absl' 'python-numpy' 'python-pandas' 'python-protobuf'
           'python-typing_extensions' 'python-immutabledict')
  python -m installer --destdir="$pkgdir" build/python/dist/*.whl
  install -Dm644 "$pkgbase-$_tag/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
