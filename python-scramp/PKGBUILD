_wheel='scramp-1.4.9-py3-none-any.whl'
source=("$_wheel::https://files.pythonhosted.org/packages/70/25/d563dc2822039e9283a106a3cc948149c46d14d85d96f434722000951267/scramp-1.4.9-py3-none-any.whl")
noextract=("$_wheel")
