# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=python-qiskit-experiments
_pkg=qiskit_experiments
pkgver=0.14.2
# pkgrel 2 replaces the AUR build of the GitHub tag archive, which lacks the
# randomized-benchmarking .npz tables the PyPI sdist ships.
pkgrel=2
pkgdesc="Qiskit Experiments: characterization, calibration and verification experiments"
arch=('any')
url="https://github.com/qiskit-community/qiskit-experiments"
license=('Apache-2.0')
depends=('python' 'python-lmfit' 'python-matplotlib' 'python-numpy' 'python-packaging' 'python-pandas'
         'python-qiskit' 'python-qiskit-ibm-runtime' 'python-rustworkx' 'python-scipy' 'python-uncertainties')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-setuptools-scm' 'python-wheel')
source=("https://files.pythonhosted.org/packages/source/q/$_pkg/$_pkg-$pkgver.tar.gz")
sha256sums=('b06b46311d022ed4a15dc3e0ec89d3a7965caec1e58a758f23727085fb404ce4')

build() {
	cd "$_pkg-$pkgver"
	python -m build --wheel --no-isolation
}

package() {
	cd "$_pkg-$pkgver"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
