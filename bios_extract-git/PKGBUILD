# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
# Local fork: pkgver() reads HEAD instead of the master branch.
# coreboot/bios_extract renamed its default branch from master to main, so a
# fresh `git clone` leaves no local `master` ref and both substitutions in the
# upstream pkgver() fail with "fatal: ambiguous argument 'master'". pkgver then
# evaluates to the literal "r.", which pacman installs as version "r.-1" and
# which never compares newer, so every -Syu offers the same phantom upgrade.
# HEAD tracks whichever branch makepkg checked out and survives a future rename.

pkgname=bios_extract-git
pkgver=r131.0a7bc1d
pkgrel=1
pkgdesc='Tool for extracting individual modules from proprietary BIOS images'
arch=(i686 x86_64)
url='http://www.coreboot.org/Bios_extract'
license=(GPL2)
depends=(glibc)
makedepends=(git)
provides=(bios_extract)
conflicts=(bios_extract)
source=(git+https://github.com/coreboot/bios_extract)
sha1sums=('SKIP')

pkgver() {
  cd bios_extract
  echo "r$(git rev-list --count HEAD).$(git rev-parse --short HEAD)"
}

build() {
  cd bios_extract
  make
}

package() {
  cd bios_extract
  mkdir -p "$pkgdir"/usr/bin
  install -t "$pkgdir"/usr/bin bios_extract bcpvpd ami_slab xfv/efidecomp
  install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}
