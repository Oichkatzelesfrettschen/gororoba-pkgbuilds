# PyPI publishes a wheel and no sdist.
# windows-curses is a Windows environment marker and is not a dependency here.
# Running the emulator needs Docker. This recipe does not start it.

pkgname=python-localstack
pkgver=2026.8.2
pkgrel=1
pkgdesc='Local implementation of AWS cloud APIs'
arch=('any')
url='https://github.com/localstack/localstack'
license=('Apache-2.0')
depends=('python' 'python-asn1crypto' 'python-cachetools' 'python-click' 'python-cryptography' 'python-dnslib' 'python-dnspython' 'python-docker' 'python-packaging' 'python-plux' 'python-psutil' 'python-pyjwt' 'python-pyotp' 'python-dateutil' 'python-dotenv' 'python-yaml' 'python-requests' 'python-rich' 'python-semver' 'python-tabulate')
makedepends=('python-installer')
_wheel='localstack-2026.8.2-py3-none-any.whl'
source=("$_wheel::https://files.pythonhosted.org/packages/76/48/65d4dda90154cfb4c4baedcbb40fbe130bfd19464fa84ace5f5f78d1657e/localstack-2026.8.2-py3-none-any.whl")
noextract=("$_wheel")
sha256sums=('bea702f5d8558cafc9fbbffbd81a1e5320872720e08cd6be1a4f1da694abdee7')

package() {
	python -m installer --destdir="$pkgdir" "$_wheel"
}
