# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=python-types-array-api
_pkg=types_array_api
pkgver=1.3.0
pkgrel=1
pkgdesc="Typing protocols of the Python array API standard"
arch=('any')
url="https://github.com/34j/types-array-api"
license=('MIT' 'Apache-2.0')
depends=('python' 'python-typing_extensions')
makedepends=('python-build' 'python-installer' 'python-setuptools')
source=("https://files.pythonhosted.org/packages/source/t/types-array-api/$_pkg-$pkgver.tar.gz")
sha256sums=('918526e110c1008618cd9b4487f98aa518f3869efc67b0da2491ceff1b53efcd')

build() {
	cd "$_pkg-$pkgver"
	python -m build --wheel --no-isolation
}

check() {
	cd "$_pkg-$pkgver"
	PYTHONPATH="$PWD/src" python -c "import array_api"
}

package() {
	cd "$_pkg-$pkgver"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
