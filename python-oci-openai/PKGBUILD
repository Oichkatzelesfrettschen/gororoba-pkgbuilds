# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=python-oci-openai
_pkg=oci-openai
pkgver=1.1.0
pkgrel=1
_srcdir=oci_openai-$pkgver
pkgdesc="OCI request signing for the OpenAI Python SDK"
arch=('any')
url="https://github.com/oracle-samples/oci-openai"
license=('UPL-1.0')
depends=('python' 'python-httpx' 'python-oci' 'python-openai' 'python-requests')
makedepends=('python-build' 'python-installer' 'python-hatchling')
source=("https://files.pythonhosted.org/packages/f7/93/c395a92c8019dec50bd5760a9fcfd718cedb416824f8ebba0b26568ab6f4/oci_openai-1.1.0.tar.gz")
sha256sums=('1819ef7d17c1fdbe05c5c0653301fdca0d2fa99f6f8b1b7bd7667da9704d62a1')

build() {
	cd "$_srcdir"
	python -m build --wheel --no-isolation
}

package() {
	cd "$_srcdir"
	python -m installer --destdir="$pkgdir" dist/*.whl
	find . -maxdepth 1 -iname 'LICENSE*' -exec install -Dm644 {} "$pkgdir/usr/share/licenses/$pkgname/" \;
}
