# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
# Why: CV-CUDA has no Arch or AUR package. NVIDIA publishes the CUDA 13 x86_64
#      library and development archives on the GitHub release with SHA-256
#      digests in the release metadata, and the archives unpack to
#      /opt/nvidia/cvcuda0 with their own ld.so.conf.d entry, so the package
#      installs that tree verbatim and registers the loader path. The qwen-nvidia
#      tree records the same digests in scripts/nvidia-sdk-artifacts.tsv and its
#      verifier reads the installed files against them. CUDA 13 builds of CV-CUDA
#      require driver R580 or newer; the workstation runs R610.

pkgname=cvcuda-bin
pkgver=0.19.0
pkgrel=1
pkgdesc='NVIDIA CV-CUDA 0.19.0 GPU image and vision operators, CUDA 13 x86_64 library and headers'
arch=(x86_64)
url='https://github.com/CVCUDA/CV-CUDA'
license=('Apache-2.0')
depends=('cuda>=13' 'nvidia-utils>=580')
provides=(cvcuda)
conflicts=(cvcuda)
options=(!strip)

_release="https://github.com/CVCUDA/CV-CUDA/releases/download/v${pkgver}"
source=(
    "cvcuda-lib-${pkgver}-cuda13-x86_64-linux.tar.xz::${_release}/cvcuda-lib-${pkgver}-cuda13-x86_64-linux.tar.xz"
    "cvcuda-dev-${pkgver}-cuda13-x86_64-linux.tar.xz::${_release}/cvcuda-dev-${pkgver}-cuda13-x86_64-linux.tar.xz"
)
sha256sums=('fc655a8eda2ea9e16ed3f255338534f6d33eda0f01a9f18149b9f47a2aca9205'
            '3d545e78bad59b924a8642e826ec871c63b4fb92f4e746dff39a3d5949637446')

package() {
    install -d "${pkgdir}/opt/nvidia"
    cp -a "${srcdir}/opt/nvidia/cvcuda0" "${pkgdir}/opt/nvidia/cvcuda0"
    # The archive's own loader entry names /opt/nvidia/cvcuda0/lib/.
    install -d "${pkgdir}/etc/ld.so.conf.d"
    install -m644 "${srcdir}/opt/nvidia/cvcuda0/etc/ld.so.conf.d/"*.conf \
        "${pkgdir}/etc/ld.so.conf.d/cvcuda0.conf"
    rm -rf "${pkgdir}/opt/nvidia/cvcuda0/etc"
    install -Dm644 "${srcdir}/opt/nvidia/cvcuda0/doc/CVCUDA_EULA.txt" \
        "${pkgdir}/usr/share/licenses/${pkgname}/CVCUDA_EULA.txt"
}
