# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
# Contributor: Iyán Méndez Veiga <me (at) iyanmv (dot) com>
_name=qiskit-addon-sqd
pkgname=python-$_name
pkgver=0.14.1
pkgrel=1
pkgdesc="Sample-based Quantum Diagonalization"
arch=(any)
url=https://github.com/Qiskit/qiskit-addon-sqd
license=(Apache-2.0)
depends=(
    python-jax
    python-jaxlib
    python-numpy
    python-pyscf
    python-qiskit
    python-scipy
)
makedepends=(
    python-build
    python-installer
    python-hatchling
)
# optdepends=(
#     'python-fulqrum'
#     'python-primme'
#     'python-sbd-eigensolver'
# )
checkdepends=(python-pytest)
source=($_name-$pkgver.tar.gz::https://github.com/Qiskit/$_name/archive/refs/tags/$pkgver.tar.gz)
sha256sums=('95d5bd336d59a7ae44faaaca45ff0a7818528a50f0bd2f3be443c8752fa053ee')

build() {
    cd $_name-$pkgver
    python -m build --wheel --no-isolation
}

check() {
    cd $_name-$pkgver
    python -m venv --system-site-packages test-env
    test-env/bin/python -m installer dist/*.whl
    rm -rf ${_name//-/_}
    test-env/bin/python -P -m pytest -o addopts="" test
}

package() {
    cd $_name-$pkgver
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -D -m644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
