# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
# Contributor: Iyán Méndez Veiga <me (at) iyanmv (dot) com>
_name=scipy-doctest
pkgname=python-${_name}
pkgver=2.2.0
pkgrel=1
_dir=scipy_doctest-$pkgver
pkgdesc="Floating-point aware doctesting "
arch=(any)
url=https://github.com/scipy/scipy_doctest
license=(BSD-3-Clause)
depends=(
    python-numpy
    python-pytest
)
makedepends=(
    python-build
    python-flit-core
    python-installer
)
checkdepends=(
    python-matplotlib
    python-scipy
)
source=($_name-$pkgver.tar.gz::https://github.com/scipy/scipy_doctest/archive/refs/tags/v$pkgver.tar.gz)
sha256sums=('b39a67caa919ef98ea03d5007336176c531ed60c2887f94e19a951087ca8a6f2')

build() {
    cd $_dir
    python -m build --wheel --no-isolation
}

check() {
    cd $_dir
    python -m venv --system-site-packages test-env
    test-env/bin/python -m installer dist/*.whl
    mv scipy_doctest/tests .
    rm -rf scipy_doctest
    test-env/bin/python -P -m pytest -o addopts="" --pyargs scipy_doctest
}

package() {
    cd $_dir
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
    local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
    rm -rf "$pkgdir"/$site_packages/scipy_doctest/tests
}
