# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>

pkgname=python-perceval-interop
_name=perceval_interop
pkgver=1.3.1
pkgrel=3
pkgdesc="Converters between Perceval and Qiskit, QuTiP, myQLM and cQASM"
arch=('any')
url="https://github.com/Quandela/Perceval_Interop"
license=('MIT')
depends=('python' 'python-perceval-quandela')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-setuptools-scm' 'python-wheel' 'python-scmver')
optdepends=('python-qiskit: Qiskit circuit converter' 'python-seaborn: Qiskit converter plots' 'python-qutip: QuTiP converter' 'libqasm: cQASM converter')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/$_name/$_name-$pkgver.tar.gz"
        myqlm-fallback.patch)
b2sums=('635adeccdbd02a8cf25f747a6bfa31ab2178b81d7a8b32a4ce70abb1e3b2fc82882ead62952102559caee445a72325dc959cbfc4a08c135f786480f7d9d27f45'
        '7ceee411d41bd96a79a9d7fefca53791e11a038cf57b47849fcfa7cd07352e4afa88b577b55cfe793c817ecdc95ac396ecff148b89473ee09edc3cf1d2c1bd72')

prepare() {
	cd "$_name-$pkgver"
	# The package __init__ imports MyQLMCommunicationLayer, which the
	# missing-myqlm fallback leaves undefined, so every import fails without myqlm.
	patch -Np1 -i "$srcdir/myqlm-fallback.patch"
	# scmver reads the version from git, which the sdist lacks, and falls
	# back to 0.0.0; PKG-INFO carries the release version.
	sed -i "s/scmver=True/version=\"$pkgver\"/" setup.py
}

build() {
	cd "$_name-$pkgver"
	python -m build --wheel --no-isolation
}

package() {
	cd "$_name-$pkgver"
	python -m installer --destdir="$pkgdir" dist/*.whl
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
