# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
#
# WHY:  rivalcfg 4.17.0 ships a shared rival700.py profile that covers both
#       the Rival 700 and the Rival 710 with the same five settings (DPI
#       presets, polling rate, two-zone RGB, save, firmware version).  That
#       is roughly 20% of what the Rival 710 firmware actually exposes.
#       Everything else (lift-off distance, sleep timeout, profile slots,
#       button remapping, scroll-wheel parameters, tactile feedback, OLED)
#       requires modifying rivalcfg.  Since rivalcfg has no plugin hook --
#       devices are static dicts dispatched by VID/PID in
#       devices/__init__.py -- overlay-style modification is not possible
#       without a pacman file conflict.
#
# WHAT: rivalcfg-rival710 is a drop-in replacement for stock rivalcfg.  It
#       carries a pinned upstream tarball, splits the Rival 710 out of
#       rival700.py into its own devices/rival710.py profile (PR #1 to
#       upstream once verified), and is the scaffold for landing
#       710-specific features one at a time as each is verified
#       end-to-end against the physical hardware per the wiggly-catmull
#       verification protocol.
#
#       conflicts=('rivalcfg'), provides='rivalcfg=4.17.0',
#       replaces=('rivalcfg').  Installing this package removes stock
#       rivalcfg, and pacman re-installs of rivalcfg from extra will pull
#       this fork back (since provides==stock version).
#
# HOW:  Build pinned upstream rivalcfg tarball, apply rival700.py.patch in
#       prepare() to drop the 710 entry from the shared profile, drop the
#       new rival710.py into rivalcfg/devices/, install via python-build +
#       python-installer per the repo CLAUDE.md Python packaging standard.
#
# STATUS (4.17.0-5): file-split refactor + one verified new setting --
#         **tactile button mapping** (--tactile-mapping / -t) wire-
#         verified on hardware (frame 2088 of captures/tactile/).
#         The 4.17.0-4 --oled-image flag has been REMOVED after
#         negative-verification: cmd 0x61 + 578-byte FEATURE goes
#         through at the USB level (frame 84 of captures/oled-
#         negative/) but the OLED is unchanged afterward.  The
#         handler module stays as infrastructure for when the real
#         OLED command arrives.  Subsequent bumps will add OLED,
#         lift-off, sleep, profile-slot, button-remap, wheel-remap
#         as each is captured and verified.  See in-tree commands.md.

pkgname=rivalcfg-rival710
_upstream_pkgname=rivalcfg
pkgver=4.17.0
pkgrel=5
pkgdesc="rivalcfg fork carrying the Rival 710 split-profile refactor (scaffold for future 710-specific features)"
arch=('any')
url='https://github.com/flozz/rivalcfg'
license=('WTFPL')
depends=('python' 'python-hidapi' 'python-pillow')
makedepends=('python-build' 'python-installer' 'python-flit-core' 'python-wheel')
conflicts=('rivalcfg')
provides=("rivalcfg=${pkgver}")
replaces=('rivalcfg')

source=("${_upstream_pkgname}-${pkgver}.tar.gz::https://github.com/flozz/rivalcfg/archive/refs/tags/v${pkgver}.tar.gz"
        'rival710.py'
        'rival700.py.patch'
        'devices-init.py.patch'
        'handlers-init.py.patch'
        'tactile_button_map.py'
        'handlers-init-oled.py.patch'
        'oled_image.py')
sha256sums=('9ef0512b097ce46b77d0c74eb9c84411250c91a4dea1c77469a41bfacbe8705d'
            'a68a94ee4cd83a0502b65ef90f0abc34e0cca8f9fc368bcb2e9ec2ca3efb56e8'
            '965a336d7fc917f6acc7b58099d1af72963a4179bf260dc8bf88ddfeea93a4bd'
            'd06d1d3700198122ab89b8416c0b073650889ab67871490011caaa6eaf37b3e6'
            'd668821896ef3e74663a0b2f3a14e10089d8b88b5bbc83ef3012640ed188b554'
            'cd5be04e43bc64fa8c84096c7bbc6bfba181557962c6c614ef1534f91e380f5e'
            '1c4d7e8e047b08f82ebff0827349a1692f9e8eb8ffb836c21ee186479bfb2c3d'
            'c457559238bb45b2227dcf16253c868b43d2e45fb15b44bb4fd756860912718a')

prepare() {
    cd "${srcdir}/${_upstream_pkgname}-${pkgver}"
    # Relax the upper bound on flit_core: upstream pins <4, Arch ships 4.0.
    # 4.x is API-compatible with 3.x for our use; same workaround the Arch
    # python-rivalcfg packager applies.
    sed -i 's/flit_core >=3.2,<4/flit_core >=3.2/' pyproject.toml
    patch -p1 --no-backup-if-mismatch < "${srcdir}/rival700.py.patch"
    patch -p1 --no-backup-if-mismatch < "${srcdir}/devices-init.py.patch"
    patch -p1 --no-backup-if-mismatch < "${srcdir}/handlers-init.py.patch"
    patch -p1 --no-backup-if-mismatch < "${srcdir}/handlers-init-oled.py.patch"
    cp "${srcdir}/rival710.py" rivalcfg/devices/rival710.py
    cp "${srcdir}/tactile_button_map.py" rivalcfg/handlers/tactile_button_map.py
    cp "${srcdir}/oled_image.py" rivalcfg/handlers/oled_image.py
}

build() {
    cd "${srcdir}/${_upstream_pkgname}-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/${_upstream_pkgname}-${pkgver}"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
